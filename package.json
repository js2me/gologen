{
  "name": "gologen",
  "version": "1.0.0",
  "description": "Deterministic SVG identicon generator",
  "keywords": [
    "identicon",
    "logo",
    "avatar",
    "svg",
    "generator",
    "deterministic",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "js2me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/js2me/gologen.git"
  },
  "bugs": {
    "url": "https://github.com/js2me/gologen/issues"
  },
  "homepage": "https://js2me.github.io/gologen/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc --emitDeclarationOnly && vite build",
    "build:watch": "pnpm build && vite build --watch",
    "ts:check": "tsc --noEmit",
    "test": "pnpm build && node scripts/test.mjs",
    "perf:test": "pnpm build && node scripts/perf-test.mjs",
    "size": "pnpm build && size-limit",
    "prepublishOnly": "pnpm build",
    "docs": "docusite dev",
    "docs:build": "docusite build",
    "docs:serve": "docusite preview",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "docusite": "^0.2.0",
    "size-limit": "^13.0.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 KB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "2 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.8.0"
}
